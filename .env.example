# ==========================================
# PICSLIVE ENVIRONMENT CONFIGURATION (MVP)
# ==========================================

# Port d'écoute Next.js
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mode Moteur Biométrique : "SIMULATOR" (défaut) ou "AWS_REKOGNITION"
FACE_ENGINE_MODE=SIMULATOR

# Seuils de similarité faciale (sur 100)
SIMILARITY_THRESHOLD_SURE=95
SIMILARITY_THRESHOLD_PROBABLE=85

# AWS Rekognition (Activé si FACE_ENGINE_MODE=AWS_REKOGNITION)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REKOGNITION_COLLECTION_PREFIX=picslive_

# Supabase (Activé en production / phase ultérieure)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paramètres généraux
NEXT_PUBLIC_DEFAULT_EVENT_CODE=GALA-2026

